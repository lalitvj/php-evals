{
    "name": "php-evals/laravel",
    "description": "Laravel bridge package for php-evals core.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "php-evals/core": "*"
    },
    "autoload": {
        "psr-4": {
            "PhpEvals\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhpEvals\\Laravel\\LaravelEvalsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
