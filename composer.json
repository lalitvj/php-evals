{
    "name": "php-evals/php-evals",
    "description": "Framework-agnostic PHP eval toolkit with an optional Laravel bridge.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PhpEvals\\Core\\": "packages/core/src/",
            "PhpEvals\\Laravel\\": "packages/laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpEvals\\Core\\Tests\\": "packages/core/tests/",
            "PhpEvals\\Laravel\\Tests\\": "packages/laravel/tests/"
        }
    },
    "bin": [
        "packages/core/bin/php-evals"
    ],
    "scripts": {
        "test": "phpunit --configuration=phpunit.xml.dist --coverage-text --coverage-clover=coverage/clover.xml",
        "analyse": "phpstan analyse --memory-limit=512M --configuration=phpstan.neon.dist",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
